# ── Admin Authentication ──────────────────────────────────
# Email that can access the admin portal (OTP sent here)
ADMIN_EMAIL=your-email@example.com

# ── Gmail SMTP (for sending OTP emails) ──────────────────
# Use Gmail App Password, NOT your login password
# Generate at: https://myaccount.google.com/apppasswords
Gmail_USER=your-gmail@gmail.com
Gmail_PASS=your-16-char-app-password

# ── AI Assistant (optional) ──────────────────────────────
# Supports OpenAI-compatible APIs
NEXT_PUBLIC_AI_API_URL=https://api.openai.com/v1/chat/completions
NEXT_PUBLIC_AI_API_KEY=sk-your-api-key
NEXT_PUBLIC_AI_MODEL=gpt-3.5-turbo

# ── Server-side AI (alternative, non-public) ─────────────
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-your-api-key
# AI_MODEL=gpt-3.5-turbo
